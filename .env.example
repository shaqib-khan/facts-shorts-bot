# OpenAI-compatible LLM (Groq, OpenAI, Gemini OpenAI-compat, OpenRouter, or Ollama)
# If left blank, the pipeline uses a built-in keyword heuristic fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Clip & source constraints (seconds)
CLIP_MIN_SEC=25
CLIP_MAX_SEC=55
MIN_SOURCE_SEC=90
MAX_SOURCE_SEC=2700

# YouTube Category ID (28 = Science & Technology, 27 = Education)
YT_CATEGORY_ID=28

# YouTube OAuth (for CI / GitHub Actions; locally you can use secrets/youtube_token.json)
YT_CLIENT_ID=
YT_CLIENT_SECRET_VALUE=
YT_REFRESH_TOKEN=

